<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Manna Colombian Bakery | Digital Menu</title>
<meta name="description" content="Drinks menu for Manna Colombian Bakery, Hopewell, Virginia.">
<meta name="theme-color" content="#D4B284">
<link rel="icon" href="data:image/png;base64," type="image/png">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Montserrat:wght@400;500;600&display=swap">
<style>
/* Layout: tan logo band, sticky Hot/Iced switch with category chips, then one long column of sections listing drinks as hairline-divided rows. Single light theme on purpose: the menu always looks like Manna. */
:root {
  color-scheme: light;
  --tan: #D4B284;          /* Manna tan, exact from logo file */
  --ivory: #F7F1E6;        /* page */
  --paper: #FFFDF8;        /* section panels */
  --espresso: #2E2018;     /* names, prices, headings */
  --roast: #6B5443;        /* descriptions */
  --gold: #7D5F36;         /* readable tan for small labels */
  --forest: #2F3D2C;       /* active switch */
  --kraft: #EADBC3;        /* chips, track */
  --line: #E6D8C2;         /* hairlines */
  --flag: #9A3F1F;         /* review-only notes */
  --font-display: "Cormorant Garamond", "Iowan Old Style", Georgia, serif;
  --font-body: "Montserrat", "Helvetica Neue", Arial, sans-serif;
  --gutter-l: max(16px, env(safe-area-inset-left, 0px));
  --gutter-r: max(16px, env(safe-area-inset-right, 0px));
  --nav-h: 112px;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
img { max-width: 100%; }
html { scroll-padding-top: calc(var(--nav-h) + env(safe-area-inset-top, 0px)); }
body {
  margin: 0;
  background: var(--ivory);
  color: var(--espresso);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
body::before {
  content: ""; position: fixed; inset: 0 0 auto; z-index: 10;
  height: env(safe-area-inset-top, 0px); background: var(--ivory);
}
.wrap { max-width: 560px; margin: 0 auto; padding-left: var(--gutter-l); padding-right: var(--gutter-r); }

/* Header */
.brand { background: var(--tan); }
.brand .wrap { display: flex; justify-content: center; padding-block: 20px; }


.brand img { width: 168px; height: 168px; display: block; }
.intro { text-align: center; padding-block: 26px 14px; display: grid; justify-items: center; gap: 10px; }
.intro h1 { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 32px; line-height: 1.1; letter-spacing: 0.02em; color: var(--espresso); }
.intro .rule { width: 44px; height: 1px; background: var(--tan); }

/* Review banner */
.review-banner {
  margin-top: 16px; border: 1px dashed var(--flag); border-radius: 10px;
  padding: 12px 14px; font-size: 13px; color: var(--flag); background: #FBF3EC;
}
.review-banner strong { font-weight: 600; }

/* Sticky navigation */
.nav {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5;
  background: var(--ivory); border-bottom: 1px solid var(--line);
}
.nav .wrap { padding-block: 12px 10px; display: grid; gap: 10px; }
.nav-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; }
/* Language toggle sits beside the Hot/Iced switch so it is reachable from anywhere on the page */
.lang { display: flex; background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 3px; }
.lang button {
  font: 600 12px/1 var(--font-body); letter-spacing: 0.08em;
  min-width: 40px; min-height: 42px; padding: 0 8px;
  border: 0; border-radius: 999px; background: transparent; color: var(--roast); cursor: pointer;
}
.lang button[aria-pressed="true"] { background: var(--kraft); color: var(--espresso); }
.switch { display: grid; grid-template-columns: 1fr 1fr; background: var(--kraft); border-radius: 999px; padding: 4px; }
.switch button {
  font: 500 14px/1 var(--font-body); letter-spacing: 0.04em;
  border: 0; background: transparent; color: var(--espresso);
  min-height: 42px; border-radius: 999px; cursor: pointer;
}
.switch button[aria-pressed="true"] { background: var(--forest); color: var(--paper); }
.chips {
  display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
  margin-left: calc(-1 * var(--gutter-l)); margin-right: calc(-1 * var(--gutter-r));
  padding-left: var(--gutter-l); padding-right: var(--gutter-r);
  scroll-padding-left: var(--gutter-l);
}
.chips::-webkit-scrollbar { display: none; }
.chips a {
  flex: none; font-size: 13px; font-weight: 500; color: var(--roast); text-decoration: none;
  padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--paper);
  white-space: nowrap;
}
.chips a[aria-current="true"] { color: var(--espresso); border-color: var(--tan); background: var(--kraft); }
button:focus-visible, a:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; }

/* Menu */
main { padding-block: 8px 40px; }
.part { padding-top: 28px; }
.part-title {
  display: flex; align-items: center; gap: 14px; margin: 0 0 4px;
  font-family: var(--font-display); font-weight: 600; font-size: 34px; line-height: 1.1;
}
.part-title::after { content: ""; flex: 1; height: 1px; background: var(--tan); }
.section { margin-top: 22px; background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 18px 16px 6px; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; }
.section-head h3 { flex: 1; min-width: 0; margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 25px; line-height: 1.15; text-wrap: balance; }

/* Price columns line up under the section's size labels */
.cols { display: flex; flex: none; }
.col { width: 56px; text-align: right; }
.col.wide { width: auto; min-width: 56px; }
.cols.labels .col { font-size: 10.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); padding-bottom: 3px; white-space: nowrap; }
.cols.prices .col { font-weight: 500; font-size: 15px; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--espresso); }
.section-note { margin: 6px 0 0; font-size: 12.5px; color: var(--roast); }
.items { list-style: none; margin: 10px 0 0; padding: 0; }
.item { padding: 14px 0; border-top: 1px solid var(--line); display: grid; gap: 4px; }
.item:first-child { border-top: 0; }
.item-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.item-name { flex: 1; margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 21px; line-height: 1.2; min-width: 0; }
.tag {
  display: inline-block; vertical-align: 3px; margin-left: 6px;
  font: 600 10px/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--gold); border: 1px solid var(--tan); border-radius: 999px; padding: 4px 7px;
}
.sub-label { margin: 14px 0 0; padding-top: 14px; border-top: 1px solid var(--line); font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
.flavors { margin: 6px 0 14px; font-family: var(--font-display); font-size: 20px; font-weight: 600; line-height: 1.35; }
.flavors span { white-space: nowrap; }
.flavor-note {
  display: inline-block; vertical-align: 3px; margin-left: 2px; padding: 2px 7px; border-radius: 999px;
  background: var(--kraft); color: var(--gold); font: 600 10px/1.3 var(--font-body); letter-spacing: 0.06em;
}
.flavors span + span::before { content: "·"; margin: 0 8px; color: var(--tan); }
.addons .item { padding: 11px 0; }
.addons .item-name { font-family: var(--font-body); font-size: 15px; font-weight: 500; }
.addons .desc { font-size: 13.5px; }
.desc { margin: 0; color: var(--roast); font-size: 14.5px; max-width: 46ch; }
.meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
.chip { font-size: 12px; font-weight: 500; color: var(--espresso); background: var(--kraft); border-radius: 999px; padding: 3px 10px; }
.chip.notice { background: transparent; border: 1px solid var(--line); color: var(--roast); font-weight: 400; }
.chip.size { background: transparent; border: 1px solid var(--line); color: var(--roast); }

/* Review-only marks */
.cols.prices .col.pending { font-size: 10.5px; font-weight: 600; color: var(--flag); letter-spacing: 0.02em; }
.chip.drafted { background: transparent; border: 1px dashed var(--roast); }
.desc.draft { font-style: italic; }
.badge {
  justify-self: start; display: inline-flex; align-items: center; gap: 5px; margin: 0 0 2px;
  padding: 3px 9px; border-radius: 999px; background: var(--kraft); color: var(--gold);
  font: 600 10.5px/1.3 var(--font-body); letter-spacing: 0.06em;
}
.badge svg { color: var(--tan); flex: none; }
.item-flavors { margin: 0; font-size: 13px; color: var(--roast); }
.item-flavors span { font-weight: 600; color: var(--gold); }
.with-photo { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 14px; align-items: start; margin-top: 4px; }
.with-photo-text { display: grid; gap: 4px; min-width: 0; }
.thumb { width: 84px; height: 84px; border-radius: 12px; object-fit: cover; background: var(--kraft); display: block; }
@media (min-width: 480px) { .with-photo { grid-template-columns: 96px minmax(0, 1fr); } .thumb { width: 96px; height: 96px; } }
.thumb-btn { padding: 0; border: 0; background: none; border-radius: 12px; cursor: zoom-in; display: block; }
.thumb-btn:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; }

/* Add-ons discovery: compact card at the top of the menu */
.custom-cta {
  margin-top: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  padding: 14px 16px; background: var(--paper); border: 1px solid var(--tan); border-radius: 14px;
}
.cta-text { min-width: 0; flex: 1 1 0; display: grid; gap: 2px; }
.cta-text h2 { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 22px; line-height: 1.15; }
.cta-text p { margin: 0; font-size: 13px; color: var(--roast); }
.open-addons {
  flex: none; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 0; cursor: pointer;
  background: var(--kraft); color: var(--espresso); font: 600 13px/1 var(--font-body); letter-spacing: 0.04em;
}
.open-addons:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; }

/* Add-ons sheet: bottom sheet on phones, centered card on wider screens */
.sheet {
  margin: auto auto 0; width: 100%; max-width: 560px; max-height: 85vh; padding: 0; border: 0;
  border-radius: 20px 20px 0 0; background: var(--paper); color: var(--espresso);
}
.sheet::backdrop { background: rgba(28, 19, 14, 0.55); }
.sheet-inner { display: flex; flex-direction: column; max-height: 85vh; }
.sheet-head {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 14px 12px 10px 20px; border-bottom: 1px solid var(--line);
}
.sheet-head h2 { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 26px; }
.sheet-close {
  width: 44px; height: 44px; border-radius: 999px; border: 0; cursor: pointer;
  display: grid; place-items: center; background: var(--kraft); color: var(--espresso);
}
.sheet-close:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; }
.sheet-body {
  overflow-y: auto; overscroll-behavior: contain;
  padding: 4px max(20px, env(safe-area-inset-right, 0px)) max(20px, calc(env(safe-area-inset-bottom, 0px) + 12px)) max(20px, env(safe-area-inset-left, 0px));
}
.sheet-list { list-style: none; margin: 0; padding: 0; }
.sheet-row { padding: 12px 0; border-top: 1px solid var(--line); display: grid; gap: 4px; justify-items: start; }
.sheet-row:first-child { border-top: 0; }
.sheet-row-main { width: 100%; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.sheet-name { font-size: 15px; font-weight: 500; }
.sheet-price { font-size: 15px; font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
.sheet-desc { margin: 0; font-size: 13.5px; color: var(--roast); }
.sheet-label { font-weight: 600; color: var(--gold); }
.sheet-flag { margin: 0; font-size: 12px; color: var(--flag); }
.sheet-note { margin: 8px 0 0; padding-top: 12px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--roast); }
@media (min-width: 600px) { .sheet { margin: auto; border-radius: 20px; } }

/* Lightbox */
.lightbox {
  width: 100%; max-width: 100%; height: 100%; max-height: 100%; margin: 0; border: 0;
  padding: max(56px, calc(env(safe-area-inset-top, 0px) + 56px)) max(16px, env(safe-area-inset-right, 0px)) max(24px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
  background: transparent; color: var(--paper);
  display: none; align-items: center; justify-content: center;
}
.lightbox[open] { display: flex; }
.lightbox::backdrop { background: rgba(28, 19, 14, 0.92); }
.lightbox-figure { margin: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
#lightbox-img {
  display: block; max-width: min(100%, 640px); max-height: calc(100% - 40px); width: auto; height: auto;
  border-radius: 14px; background: rgba(255, 253, 248, 0.06); opacity: 0;
}
#lightbox-img.ready { opacity: 1; }
#lightbox-caption { font-family: var(--font-display); font-size: 22px; font-weight: 600; text-align: center; color: var(--paper); }
.lightbox-close {
  position: absolute; top: max(12px, calc(env(safe-area-inset-top, 0px) + 8px)); right: max(12px, env(safe-area-inset-right, 0px));
  width: 44px; height: 44px; border-radius: 999px; border: 0; cursor: pointer;
  display: grid; place-items: center; background: var(--paper); color: var(--espresso);
}
.lightbox-close:focus-visible { outline: 2px solid var(--tan); outline-offset: 3px; }
html.lightbox-open { overflow: hidden; }
@media (prefers-reduced-motion: no-preference) { #lightbox-img { transition: opacity 0.2s ease; } }

.allergen-panel { margin-top: 18px; background: var(--paper); border: 1px solid var(--line); border-radius: 14px; }
.allergen-panel summary {
  list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px;
  min-height: 48px; padding: 12px 16px; font-size: 14px; font-weight: 600; color: var(--espresso); border-radius: 14px;
}
.allergen-panel summary::-webkit-details-marker { display: none; }
.allergen-panel summary > svg:first-child { color: var(--gold); flex: none; }
.allergen-panel summary span { flex: 1; }
.allergen-panel .chev { color: var(--roast); flex: none; }
.allergen-panel[open] .chev { transform: rotate(180deg); }
.allergen-panel summary:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; }
.allergen-body { padding: 0 16px 16px; font-size: 13.5px; line-height: 1.55; color: var(--roast); display: grid; gap: 8px; }
.allergen-body p { margin: 0; }
.allergen-body .allergen-lead { color: var(--espresso); }
.allergen-body h3 { margin: 6px 0 0; font-size: 10.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
.allergen-body ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
.allergen-body .used-in { color: var(--roast); opacity: 1; font-style: italic; }
.allergen-link {
  border: 0; background: none; padding: 3px 0; cursor: pointer; font: 500 12px/1.4 var(--font-body);
  color: var(--gold); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--tan);
}
.notice .allergen-link { justify-self: start; font-size: 13px; }
.sheet-allergen-link { margin-top: 10px; font-size: 13px; min-height: 36px; }
.allergen-notice { margin: 18px 0 0; display: flex; gap: 8px; align-items: flex-start; font-size: 12.5px; line-height: 1.5; color: var(--roast); }
.allergen-notice svg { flex: none; margin-top: 2px; color: var(--gold); }
.label-checklist { margin-top: 16px; border: 1px dashed var(--flag); border-radius: 10px; padding: 12px 14px; font-size: 12.5px; color: var(--flag); background: #FBF3EC; }
.label-checklist-title { margin: 0 0 6px; font-weight: 600; }
.label-checklist ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
.label-checklist strong { font-weight: 600; }
.review-notes { margin: 4px 0 0; padding: 0; list-style: none; font-size: 12px; color: var(--flag); }
.review-notes li::before { content: "Review: "; font-weight: 600; }

/* Footer */
.notice { margin-top: 28px; padding: 16px; border-top: 1px solid var(--tan); font-size: 13px; color: var(--roast); display: grid; gap: 8px; }
.notice h2 { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
.notice p { margin: 0; }
footer { text-align: center; padding-block: 8px 32px; font-size: 13px; color: var(--roast); display: grid; gap: 2px; }
footer .name { font-family: var(--font-display); font-size: 19px; font-weight: 600; color: var(--espresso); }

@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
@media (min-width: 600px) { .brand img { width: 196px; height: 196px; } }
</style>
</head>
<body>

<header class="brand">
  <div class="wrap">
    <img src="data:image/webp;base64," alt="Manna Colombian Bakery" width="168" height="168">
  </div>
</header>

<div class="wrap intro">
  <h1 id="page-title">Drinks Menu</h1>
  <span class="rule" aria-hidden="true"></span>
  <div id="review-banner" hidden></div>
</div>

<nav class="nav" aria-label="Menu sections">
  <div class="wrap">
    <div class="nav-row">
      <div class="switch" role="group" aria-label="Drink temperature">
        <button type="button" id="btn-hot" data-part="hot" aria-pressed="true">Hot drinks</button>
        <button type="button" id="btn-iced" data-part="iced" aria-pressed="false">Iced drinks</button>
      </div>
      <div class="lang" role="group" aria-label="Language / Idioma">
        <button type="button" data-lang="en" lang="en" aria-pressed="true" aria-label="English">EN</button>
        <button type="button" data-lang="es" lang="es" aria-pressed="false" aria-label="Español">ES</button>
      </div>
    </div>
    <div class="chips" id="chips"></div>
  </div>
</nav>

<main class="wrap" id="menu"></main>

<footer class="wrap">
  <span class="name">Manna Colombian Bakery</span>
  <span>Hopewell, Virginia</span>
  <span id="hours">Mon–Fri 7:00 am–6:00 pm · Sat 8:00 am–2:30 pm</span>
</footer>

<dialog class="sheet" id="addons-sheet" aria-labelledby="sheet-title">
  <div class="sheet-inner">
    <div class="sheet-head">
      <h2 id="sheet-title">Add-ons</h2>
      <button type="button" class="sheet-close" id="sheet-close" aria-label="Close add-ons">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
      </button>
    </div>
    <div class="sheet-body" id="sheet-body"></div>
  </div>
</dialog>

<dialog class="lightbox" id="lightbox" aria-labelledby="lightbox-caption">
  <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close photo">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
  </button>
  <figure class="lightbox-figure">
    <img id="lightbox-img" alt="">
    <figcaption id="lightbox-caption"></figcaption>
  </figure>
</dialog>

<script>
/* =====================================================================
   SETTINGS
   ===================================================================== */
const SHOW_PRICES = true;   // false hides every price on the menu
const REVIEW_MODE = false;   // false hides every review flag (do this before publishing)
const DEFAULT_LANG = "en";  // "en" or "es"

/* =====================================================================
   MENU DATA — edit drinks here; the layout updates automatically.

   Section:
     sizes      Column labels, e.g. ["12 oz", "16 oz"]. Prices line up under them.
                A section without sizes reuses the previous section's.
     es         Spanish text: { title, note }
   Drink:
     name       Display name
     desc       Short public description ("" = none yet)
     tags       ["Seasonal"] (optional; translated automatically)
     sizes      Only when different from the section, e.g. ["16 oz"].
     prices     One per size, in the same order:
                  5.25       approved price
                  "printed"  existing drink, price comes from the photographed bakery menu
                  null       no approved price yet
     contains   Allergens actually present, e.g. ["milk", "pistachio"].
                [] = none listed. null = not confirmed yet.
     drafted    true = allergen line drafted from a standard recipe; needs confirmation.
     draftDesc  true = description is a draft, not yet approved by Manna.
     flavors    Flavor choices shown under the description, no extra charge,
                e.g. ["Caramel", "Hazelnut"].
     photo      Approved Manna photo, e.g. "assets/photos/mango-matcha.webp".
                Leave it out and the drink stays text-only.
     review     Open questions, shown only in REVIEW_MODE.
     badge      Small label above the name, e.g. { en: "Customer Favorite", es: "Favorito de nuestros clientes" }.
                Delete it to remove the badge.
     active     false = kept in the data (prices, descriptions, allergens, photo) but not
                shown anywhere on the menu, in any language. Delete it to bring the drink back.
                A section whose drinks are all inactive is hidden too, along with its nav chip.
     es         Spanish text: { name, desc, allergenNote }.
                Leave out es.name to keep the original drink name in Spanish.
                Prices, sizes, allergen facts, and photos are shared by both languages.
   ===================================================================== */
const P = "printed";
/* =====================================================================
   INGREDIENTS — one shared allergen reference for the whole menu.
     allergens  Confirmed allergens this ingredient contains (applied to every drink that uses it).
     mayContain Confirmed cross-contact (shown as notices, not as "Contains").
     check      true = manufacturer label not verified yet. Its allergens list may be incomplete,
                so it is never treated as allergen-free; it shows on the internal checklist (REVIEW_MODE).
