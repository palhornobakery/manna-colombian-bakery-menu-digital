/* =====================================================================
   RENDERING — no edits needed below for menu changes.
   ===================================================================== */
let LANG = DEFAULT_LANG;
try { const saved = localStorage.getItem("manna-lang"); if (saved === "en" || saved === "es") LANG = saved; } catch (e) {}

const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const money = n => "$" + Number(n).toFixed(2);
const ui = k => UI[LANG][k];

/* Translation helpers. A missing Spanish entry falls back to English
   (never blank) and is listed in REVIEW_MODE so nothing is silently lost. */
let missing = [];
function txt(obj, field, label) {
  const en = obj[field];
  if (LANG === "en" || !en) return en;
  const es = obj.es && obj.es[field];
  if (es) return es;
  if (field === "name") return en;          // original names are kept on purpose
  missing.push(label || field);
  return en;
}
function term(word, sink) {
  if (LANG === "en") return word;
  if (TERMS_ES[word]) return TERMS_ES[word];
  sink.push(`"${word}"`);
  return word;
}
function note(n) { return n && (n[LANG] || n.en); }

function cell(v, wide, addon) {
  const cls = "col" + (wide ? " wide" : "");
  if (typeof v === "number") return `<span class="${cls}">${addon ? "+" : ""}${money(v)}</span>`;
  if (!REVIEW_MODE) return `<span class="${cls}"></span>`;
  return `<span class="${cls} pending">${v === P ? "Printed" : "Pending"}</span>`;
}

function priceCells(item, sec) {
  if (!SHOW_PRICES) return "";
  const cols = sec.sizes;
  const isz = item.sizes || cols;
  const pr = item.prices || [];
  if (!pr.length) return "";
  const overlap = cols.some(c => isz.includes(c));
  if (!overlap) return `<span class="cols prices">${cell(pr[0], true, sec.addons)}</span>`;
  return `<span class="cols prices">${cols.map(c => {
    const j = isz.indexOf(c);
    return j < 0 ? `<span class="col"></span>` : cell(pr[j]);
  }).join("")}</span>`;
}

/* Enlarged photo: embedded as photoLarge in this standalone file (full uncropped original, resized).
   Any new drink photo gets the enlargement automatically once its large version exists.
   Set photoLarge on a drink only to point somewhere else. */
const largePhoto = item => item.photoLarge || item.photo.replace("assets/photos/", "assets/photos/large/");

function bodyHTML(item, name, desc, flavors, meta) {
  const text = (desc ? `<p class="desc${REVIEW_MODE && item.draftDesc ? " draft" : ""}">${esc(desc)}</p>` : "")
    + (flavors ? `<p class="item-flavors"><span>${esc(ui("flavorsAvailable"))}</span> ${flavors.map(esc).join(" · ")}</p>` : "")
    + (meta.length ? `<div class="meta">${meta.join("")}</div>` : "");
  if (!item.photo) return text;
  return `<div class="with-photo">
    <button type="button" class="thumb-btn" data-large="${esc(largePhoto(item))}" data-name="${esc(name)}" aria-label="${esc(UI[LANG].enlarge(name))}" aria-haspopup="dialog">
      <img class="thumb" src="${esc(item.photo)}" alt="" width="84" height="84" loading="lazy" decoding="async">
    </button>
    <div class="with-photo-text">${text}</div>
  </div>`;
}

function itemHTML(item, sec, key) {
  missing = [];
  const terms = [];
  const name = txt(item, "name");
  const desc = txt(item, "desc", "description");
  const flavors = item.flavors && item.flavors.map(f => term(f, terms));
  const tags = (item.tags || []).map(t => `<span class="tag">${esc(term(t, terms))}</span>`).join("");
  const meta = [];
  if (item.sizes && !item.noSizeChip) {
    const sizes = item.sizes.map(s => /oz/.test(s) ? s : term(s, terms));
    const overlap = sec.sizes.some(c => item.sizes.includes(c));
    const label = overlap && sizes.length === 1 ? UI[LANG].only(sizes[0]) : sizes.join(" · ");
    meta.push(`<span class="chip size">${esc(label)}</span>`);
  }
  const allergens = allergensOf(item);
  if (allergens && allergens.length) {
    const list = allergens.map(a => term(a, terms)).join(", ");
    meta.push(`<span class="chip${REVIEW_MODE && item.drafted ? " drafted" : ""}">${esc(ui("contains"))} ${esc(list)}</span>`);
  }
  if (hasAllergenNotes(item)) meta.push(`<button type="button" class="allergen-link" data-open-allergens aria-controls="allergen-info">${esc(ui("allergenNotes"))}</button>`);
  /* Allergens of optional choices (e.g. hazelnut flavor), shown as a note rather than "Contains" */
  /* Option allergens (e.g. hazelnut flavor), optional add-ins, and facility advisories are listed in the Allergen Information panel. */

  const review = REVIEW_MODE ? [...(item.review || [])] : [];
  if (REVIEW_MODE) {
    if (!sec.addons && !item.desc && !item.noDesc) review.unshift("Description needed");
    if (item.desc && item.draftDesc) review.unshift("Draft description, awaiting your approval");
    if (item.ingredients) {
      const checks = labelChecks(item);
      if (checks.length) review.push(`Label check: ${checks.map(k => INGREDIENTS[k] ? INGREDIENTS[k].en : `unknown ingredient "${k}"`).join(", ")}`);
    } else if (item.contains === null && !item.hideUnconfirmed) review.push("Allergens to confirm");
    if (missing.length) review.push(`Spanish translation missing: ${missing.join(", ")} (showing English)`);
    if (terms.length) review.push(`Spanish term missing: ${terms.join(", ")} (showing English)`);
  }
  let badge = "";
  if (item.badge) {
    const label = item.badge[LANG] || item.badge.en;
    if (REVIEW_MODE && LANG === "es" && !item.badge.es) review.push("Spanish translation missing: badge (showing English)");
    badge = `<p class="badge"><svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path d="M8 14s-5.5-3.4-5.5-7.2A3 3 0 0 1 8 4.6a3 3 0 0 1 5.5 2.2C13.5 10.6 8 14 8 14z" fill="currentColor"/></svg>${esc(label)}</p>`;
  }
  return `<li class="item" data-key="${key}">
    ${badge}
    <div class="item-top">
      <h4 class="item-name">${esc(name)}${tags}</h4>
      ${priceCells(item, sec)}
    </div>
    ${bodyHTML(item, name, desc, flavors, meta)}
    ${review.length ? `<ul class="review-notes">${review.map(r => `<li>${esc(r)}</li>`).join("")}</ul>` : ""}
  </li>`;
}

const isActive = i => i.active !== false;
const sectionVisible = s => s.items.some(isActive);

function sectionHTML(sec) {
  if (!sectionVisible(sec)) return "";
  missing = [];
  const terms = [];
  const title = txt(sec, "title", "section title");
  const labels = SHOW_PRICES && sec.sizes.length
    ? `<span class="cols labels" aria-hidden="true">${sec.sizes.map(s => `<span class="col">${esc(s)}</span>`).join("")}</span>` : "";
  const flavors = sec.flavors
    ? `<p class="sub-label">${esc(ui("flavors"))}</p><p class="flavors">${sec.flavors.map(f => {
      const fl = typeof f === "string" ? { name: f } : f;
      return `<span>${esc(term(fl.name, terms))}${fl.waterOnly ? ` <small class="flavor-note">${esc(ui("waterOnly"))}</small>` : ""}</span>`;
    }).join(" ")}</p>` : "";
  const notes = REVIEW_MODE ? [...(sec.review || [])] : [];
  if (REVIEW_MODE && missing.length) notes.push(`Spanish translation missing: ${missing.join(", ")} (showing English)`);
  if (REVIEW_MODE && terms.length) notes.push(`Spanish term missing: ${terms.join(", ")} (showing English)`);
  const review = notes.length ? `<ul class="review-notes">${notes.map(r => `<li>${esc(r)}</li>`).join("")}</ul>` : "";
  return `<section class="section${sec.addons ? " addons" : ""}" id="${sec.id}" aria-labelledby="${sec.id}-h">
    <div class="section-head"><h3 id="${sec.id}-h">${esc(title)}</h3>${labels}</div>
    ${sec.note ? `<p class="section-note">${esc(note(sec.note))}</p>` : ""}
    ${review}
    <ul class="items">${sec.items.map((i, n) => isActive(i) ? itemHTML(i, sec, `${sec.id}-${n}`) : "").join("")}</ul>
    ${flavors}
  </section>`;
}

/* Internal checklist (REVIEW_MODE only): every unverified ingredient and the visible items that use it. */
function checklistHTML() {
  if (!REVIEW_MODE) return "";
  const uses = {};
  MENU.forEach(part => part.sections.forEach(sec => sec.items.filter(isActive).forEach(item => {
    labelChecks(item).forEach(k => { (uses[k] = uses[k] || []).push(item.name); });
  })));
  const rows = Object.keys(uses).map(k => `<li><strong>${esc(INGREDIENTS[k] ? INGREDIENTS[k].en : k)}</strong> — ${esc(uses[k].join(", "))}</li>`).join("");
  return rows ? `<aside class="label-checklist"><p class="label-checklist-title">Ingredient labels to verify (${Object.keys(uses).length}) — internal, hidden when REVIEW_MODE is off</p><ul>${rows}</ul></aside>` : "";
}

/* Expandable Allergen Information panel, built from the shared ingredient records. */
function allergenPanelHTML() {
  /* Each visible drink with the name customers see; fruit-drink bases are listed under their section name. */
  const visible = MENU.flatMap(p => p.sections).filter(sectionVisible)
    .flatMap(sec => sec.items.filter(isActive).map(i => ({ i, label: sec.flavors ? txt(sec, "title") : txt(i, "name") })));
  const advisories = Object.keys(INGREDIENTS).filter(k => INGREDIENTS[k].notice).map(k => {
    const used = [...new Set(visible.filter(v => (v.i.ingredients || []).includes(k)).map(v => v.label))];
    if (!used.length) return "";
    const n = INGREDIENTS[k].notice;
    return `<li>${esc(n[LANG] || n.en)}<span class="used-in"> ${esc(ui("usedIn"))} ${esc(used.join(", "))}.</span></li>`;
  }).join("");
  return `<details class="allergen-panel" id="allergen-info"${allergenPanelOpen ? " open" : ""}>
    <summary>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 7v4.2M8 4.6v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <span>${esc(ui("allergyTitle"))}</span>
      <svg class="chev" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    <div class="allergen-body">
      <p class="allergen-lead">${esc(note(NOTES.sharedEquipment))}</p>
      <p>${esc(ui("allergenIntro"))}</p>
      <h3>${esc(ui("customizeTitle"))}</h3>
      <p>${esc(ui("customizeIntro"))}</p>
      <ul>${CUSTOMIZE_NOTES.map(n => `<li>${esc(n[LANG] || n.en)}</li>`).join("")}</ul>
      ${advisories ? `<h3>${esc(ui("advisoriesTitle"))}</h3><ul>${advisories}</ul>` : ""}
    </div>
  </details>`;
}
let allergenPanelOpen = false;
function openAllergenPanel() {
  const d = document.getElementById("allergen-info");
  if (!d) return;
  d.open = true;
  d.scrollIntoView({ block: "start" });
  d.querySelector("summary").focus({ preventScroll: true });
}

function render() {
  const html = MENU.map(part => {
    let lastSizes = [];
    const sections = part.sections.map(sec => {
      sec.sizes = sec.sizes || lastSizes; lastSizes = sec.sizes;
      return sectionHTML(sec);
    }).join("");
    return `<div class="part" id="${part.id}"><h2 class="part-title">${esc(txt(part, "title"))}</h2>${sections}</div>`;
  }).join("");
  const cta = `<aside class="custom-cta" aria-labelledby="cta-h">
      <div class="cta-text">
        <h2 id="cta-h">${esc(ui("ctaTitle"))}</h2>
        <p>${esc(ui("ctaPreview"))}</p>
      </div>
      <button type="button" class="open-addons" aria-haspopup="dialog">${esc(ui("ctaButton"))}</button>
    </aside>`;
  const topNotice = allergenPanelHTML();
  document.getElementById("menu").innerHTML = checklistHTML() + topNotice + cta + html + `
    <aside class="notice" aria-label="${esc(ui("allergyTitle"))}">
      <p>${esc(note(NOTES.sharedEquipment))}</p>
      <button type="button" class="allergen-link" data-open-allergens aria-controls="allergen-info">${esc(ui("openAllergens"))}</button>
    </aside>`;
  document.getElementById("review-banner").hidden = !REVIEW_MODE;
  document.documentElement.lang = LANG;
  document.getElementById("page-title").textContent = ui("title");
  document.getElementById("btn-hot").textContent = ui("hot");
  document.getElementById("btn-iced").textContent = ui("iced");
  document.querySelector(".nav").setAttribute("aria-label", ui("navLabel"));
  document.querySelector(".switch").setAttribute("aria-label", ui("tempLabel"));
  document.getElementById("hours").textContent = ui("hours");
  document.querySelectorAll(".lang button").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.lang === LANG)));
}

/* Navigation: switch + chips follow the scroll position */
let activePart = null;
function renderChips(partId) {
  const part = MENU.find(p => p.id === partId);
  const extras = MENU.filter(p => p.nav === false).flatMap(p => p.sections);
  document.getElementById("chips").innerHTML = [...part.sections, ...extras].filter(sectionVisible)
    .map(s => `<a href="#${s.id}" data-sec="${s.id}">${esc(txt(s, "title"))}</a>`).join("");
}
function setPart(partId, force) {
  if (partId === activePart && !force) return;
  activePart = partId;
  document.querySelectorAll(".switch button").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.part === partId)));
  renderChips(partId);
}
function setSection(secId) {
  document.querySelectorAll(".chips a").forEach(a => {
    const on = a.dataset.sec === secId;
    a.setAttribute("aria-current", String(on));
    if (on) {
      const box = a.parentElement;
      const target = a.offsetLeft - parseFloat(getComputedStyle(box).paddingLeft);
      if (Math.abs(box.scrollLeft - target) > 4) box.scrollTo({ left: target, behavior: "smooth" });
    }
  });
}
function onScroll() {
  const navBottom = document.querySelector(".nav").getBoundingClientRect().bottom + 8;
  const parts = [...document.querySelectorAll(".part")];
  let partEl = parts[0];
  parts.forEach(p => { if (p.getBoundingClientRect().top <= navBottom) partEl = p; });
  const sections = [...partEl.querySelectorAll(".section")];
  let current = sections[0];
  sections.forEach(s => { if (s.getBoundingClientRect().top <= navBottom) current = s; });
  if (!current) return;
  const part = MENU.find(p => p.id === partEl.id);
  if (part.nav !== false) setPart(part.id);
  setSection(current.id);
}

/* Language switch: re-render in place and keep the same drink at the same spot on screen */
function setLang(lang) {
  if (lang === LANG) return;
  const panel = document.getElementById("allergen-info");
  allergenPanelOpen = !!(panel && panel.open);
  const navBottom = document.querySelector(".nav").getBoundingClientRect().bottom;
  let anchor = null;
  for (const el of document.querySelectorAll("[data-key], .section, .part-title")) {
    const r = el.getBoundingClientRect();
    if (r.bottom > navBottom) { anchor = el; break; }
  }
  const key = anchor && (anchor.dataset.key || anchor.id || anchor.parentElement.id);
  const offset = anchor ? anchor.getBoundingClientRect().top : 0;
  LANG = lang;
  try { localStorage.setItem("manna-lang", lang); } catch (e) {}
  render();
  setPart(activePart, true);
  if (anchor && window.scrollY > 0) {
    const el = document.querySelector(`[data-key="${key}"]`) || document.getElementById(key);
    const target = el && el.classList.contains("part") ? el.querySelector(".part-title") : el;
    if (target) window.scrollTo({ top: window.scrollY + target.getBoundingClientRect().top - offset, behavior: "instant" });
  }
  onScroll();
}

/* Photo lightbox: tap a thumbnail to see the full approved photo. Closes with X, Escape, or a tap outside the photo. */
const lightbox = document.getElementById("lightbox");
const lightboxImg = document.getElementById("lightbox-img");
let lastThumb = null;
function openLightbox(btn) {
  lastThumb = btn;
  const name = btn.dataset.name;
  lightboxImg.classList.remove("ready");
  lightboxImg.onload = () => lightboxImg.classList.add("ready");
  lightboxImg.onerror = () => { lightboxImg.onerror = null; lightboxImg.src = btn.querySelector("img").src; };
  lightboxImg.alt = UI[LANG].photoOf(name);
  lightboxImg.src = btn.dataset.large;
  document.getElementById("lightbox-caption").textContent = name;
  document.getElementById("lightbox-close").setAttribute("aria-label", ui("close"));
  const y = window.scrollY;
  lightbox.showModal();
  document.documentElement.classList.add("lightbox-open");
  window.scrollTo({ top: y, behavior: "instant" });
  document.getElementById("lightbox-close").focus();
}
function closeLightbox() { if (lightbox.open) lightbox.close(); }
lightbox.addEventListener("close", () => {
  const y = window.scrollY;
  document.documentElement.classList.remove("lightbox-open");
  window.scrollTo({ top: y, behavior: "instant" });
  if (lastThumb && document.contains(lastThumb)) lastThumb.focus({ preventScroll: true });
});
lightbox.addEventListener("click", e => { if (e.target === lightbox || e.target.classList.contains("lightbox-figure")) closeLightbox(); });
document.getElementById("lightbox-close").addEventListener("click", closeLightbox);
/* Add-ons sheet: built from the same add-on data as the list at the bottom, so prices always match. */
const sheet = document.getElementById("addons-sheet");
let sheetOpener = null;
function addonsSheetHTML() {
  const sec = MENU.flatMap(p => p.sections).find(s => s.id === "add-ons");
  const rows = sec.items.filter(isActive).map(item => {
    const chips = [];
    const al = allergensOf(item);
    if (al && al.length) chips.push(`${ui("contains")} ${al.map(a => LANG === "es" ? (TERMS_ES[a] || a) : a).join(", ")}`);

    const price = typeof item.prices[0] === "number" ? `+${money(item.prices[0])}` : "";
    const flag = REVIEW_MODE && labelChecks(item).length ? `<p class="sheet-flag">Label check pending</p>` : "";
    const desc = txt(item, "desc");
    return `<li class="sheet-row">
      <div class="sheet-row-main"><span class="sheet-name">${esc(txt(item, "name"))}</span>${price ? `<span class="sheet-price">${price}</span>` : ""}</div>
      ${desc ? `<p class="sheet-desc">${esc(desc)}</p>` : ""}
      ${item.flavors ? `<p class="sheet-desc"><span class="sheet-label">${esc(ui("flavorsAvailable"))}</span> ${item.flavors.map(f => esc(LANG === "es" ? (TERMS_ES[f] || f) : f)).join(" · ")}</p>` : ""}
      ${chips.map(c => `<span class="chip">${esc(c)}</span>`).join("")}
      ${flag}
    </li>`;
  }).join("");
  return `<ul class="sheet-list">${rows}</ul><p class="sheet-note">${esc(note(NOTES.addonsIncluded))}</p>
    <button type="button" class="allergen-link sheet-allergen-link" data-open-allergens aria-controls="allergen-info">${esc(ui("openAllergens"))}</button>`;
}
function openSheet(btn) {
  sheetOpener = btn;
  document.getElementById("sheet-title").textContent = ui("sheetTitle");
  document.getElementById("sheet-close").setAttribute("aria-label", ui("closeSheet"));
  document.getElementById("sheet-body").innerHTML = addonsSheetHTML();
  const y = window.scrollY;
  sheet.showModal();
  document.documentElement.classList.add("lightbox-open");
  window.scrollTo({ top: y, behavior: "instant" });
  document.getElementById("sheet-body").scrollTop = 0;
  document.getElementById("sheet-close").focus();
}
sheet.addEventListener("close", () => {
  const y = window.scrollY;
  document.documentElement.classList.remove("lightbox-open");
  window.scrollTo({ top: y, behavior: "instant" });
  if (sheetOpener && document.contains(sheetOpener)) sheetOpener.focus({ preventScroll: true });
});
sheet.addEventListener("click", e => { if (e.target === sheet) sheet.close(); });
document.getElementById("sheet-close").addEventListener("click", () => sheet.close());
document.getElementById("sheet-body").addEventListener("click", e => {
  if (e.target.closest("[data-open-allergens]")) { sheetOpener = null; sheet.close(); openAllergenPanel(); }
});

document.getElementById("menu").addEventListener("click", e => {
  const btn = e.target.closest(".thumb-btn");
  if (btn) openLightbox(btn);
  const cta = e.target.closest(".open-addons");
  if (cta) openSheet(cta);
  if (e.target.closest("[data-open-allergens]")) openAllergenPanel();
});

render();
setPart("hot");
document.querySelectorAll(".switch button").forEach(b => b.addEventListener("click", () => {
  document.getElementById(b.dataset.part).scrollIntoView();
}));
document.querySelectorAll(".lang button").forEach(b => b.addEventListener("click", () => setLang(b.dataset.lang)));
let ticking = false;
window.addEventListener("scroll", () => {
  if (ticking) return; ticking = true;
  requestAnimationFrame(() => { onScroll(); ticking = false; });
}, { passive: true });
onScroll();
</script>
</body>
</html>
